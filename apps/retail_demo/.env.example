# Set your own local password before starting PostgreSQL; this is a placeholder.
DEMO_DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD
DEMO_DB_PORT=55432
DEMO_DATABASE_URL=postgresql://retail_demo:${DEMO_DB_PASSWORD}@127.0.0.1:55432/retail_demo
DEMO_CUSTOMER_ID=demo-alice
DEMO_MCP_PORT=8811
DEMO_PARLANT_PORT=8810
DEMO_TOOL_PORT=8812
DEMO_PARLANT_HOME=runtime-data/retail-demo/parlant
# Native session/customer/context-variable stores default to PostgreSQL.
# Use storage_migration commands to switch/roll back; do not force local mode here.
DEMO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional existing HF model cache; default: <project>/runtime-data/huggingface
# DEMO_HF_HOME=/path/to/huggingface
# DEEPSEEK_API_KEY is read from project-root .env; never paste it in this example.
